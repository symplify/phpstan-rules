conditionalTags:
    Symplify\PHPStanRules\Rules\Doctrine\NoGetRepositoryOutsideServiceRule:
        phpstan.rules.rule: %symplify.doctrine%
    Symplify\PHPStanRules\Rules\Doctrine\NoParentRepositoryRule:
        phpstan.rules.rule: %symplify.doctrine%
    Symplify\PHPStanRules\Rules\Doctrine\NoGetRepositoryOnServiceRepositoryEntityRule:
        phpstan.rules.rule: %symplify.doctrine%

    Symplify\PHPStanRules\Rules\Doctrine\NoDoctrineListenerWithoutContractRule:
        phpstan.rules.rule: %symplify.doctrine%

    # test fixtures
    Symplify\PHPStanRules\Rules\Doctrine\RequireQueryBuilderOnRepositoryRule:
        phpstan.rules.rule: %symplify.doctrine%

    # entity mapping
    Symplify\PHPStanRules\Rules\Doctrine\NoStringTargetEntityRule:
        phpstan.rules.rule: %symplify.doctrine%
    Symplify\PHPStanRules\Rules\Doctrine\NoReadonlyEntityClassRule:
        phpstan.rules.rule: %symplify.doctrine%

    # collection typing
    Symplify\PHPStanRules\Rules\Doctrine\CollectionGetterMustReturnCollectionRule:
        phpstan.rules.rule: %symplify.doctrine%
    Symplify\PHPStanRules\Rules\Doctrine\CollectionReturnMustHaveGenericDocblockRule:
        phpstan.rules.rule: %symplify.doctrine%
    Symplify\PHPStanRules\Rules\Doctrine\CollectionParamMustHaveGenericDocblockRule:
        phpstan.rules.rule: %symplify.doctrine%
    Symplify\PHPStanRules\Rules\Doctrine\CollectionPropertyMustHaveGenericDocblockRule:
        phpstan.rules.rule: %symplify.doctrine%

    # repository
    Symplify\PHPStanRules\Rules\Doctrine\RepositoryMethodMustHaveReturnTypeRule:
        phpstan.rules.rule: %symplify.doctrine%

services:
    - Symplify\PHPStanRules\Rules\Doctrine\NoGetRepositoryOutsideServiceRule
    - Symplify\PHPStanRules\Rules\Doctrine\NoParentRepositoryRule
    - Symplify\PHPStanRules\Rules\Doctrine\NoGetRepositoryOnServiceRepositoryEntityRule
    - Symplify\PHPStanRules\Rules\Doctrine\NoDoctrineListenerWithoutContractRule
    - Symplify\PHPStanRules\Rules\Doctrine\RequireQueryBuilderOnRepositoryRule
    - Symplify\PHPStanRules\Rules\Doctrine\NoStringTargetEntityRule
    - Symplify\PHPStanRules\Rules\Doctrine\NoReadonlyEntityClassRule
    - Symplify\PHPStanRules\Rules\Doctrine\CollectionGetterMustReturnCollectionRule
    - Symplify\PHPStanRules\Rules\Doctrine\CollectionReturnMustHaveGenericDocblockRule
    - Symplify\PHPStanRules\Rules\Doctrine\CollectionParamMustHaveGenericDocblockRule
    - Symplify\PHPStanRules\Rules\Doctrine\CollectionPropertyMustHaveGenericDocblockRule
    - Symplify\PHPStanRules\Rules\Doctrine\RepositoryMethodMustHaveReturnTypeRule
