includes:
    - ../../../config/included_services.neon

services:
    -
        class: Symplify\PHPStanRules\Rules\ForbiddenStaticClassConstFetchRule
        tags: [phpstan.rules.rule]
    -
        class: Symplify\PHPStanRules\Collector\StaticClassConstFetchCollector
        tags: [phpstan.collector]
    -
        class: Symplify\PHPStanRules\Collector\ClassConstantDeclarationCollector
        tags: [phpstan.collector]
